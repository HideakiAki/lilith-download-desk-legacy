{
  "manifest_version": 3,
  "name": "Lilith Download Companion",
  "version": "1.3.0",
  "description": "Floating video button, Send to Lilith, and optional automatic Chrome download handoff.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lilith Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video_button.js"
      ],
      "css": [
        "video_button.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
